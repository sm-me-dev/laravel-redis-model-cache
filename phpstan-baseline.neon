parameters:
    ignoreErrors:
        # Redis clients expose command results as mixed; these are narrowed at
        # runtime by Laravel's Redis adapter and cannot be typed without a
        # client-specific Redis stub.
        -
            identifier: offsetAccess.nonOffsetAccessible
        -
            identifier: binaryOp.invalid
        -
            identifier: encapsedStringPart.nonString
        -
            identifier: argument.unpackNonIterable
        -
            identifier: argument.type
